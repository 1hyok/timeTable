{
    "files.autoSave": "off",
    "files.autoSaveDelay": 1000,
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "\\.cpp$|\\.h$",
                "cmd": "cd ${workspaceFolder}/build && cmake --build ."
            }
        ]
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true
}